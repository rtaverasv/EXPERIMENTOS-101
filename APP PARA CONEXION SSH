        "from netmiko import ConnectHandler\n",
        "import sys\n",
        "from colorama import init, Fore, Style\n",
        "\n",
        "# Inicializamos colorama para que autorestablesca el color al final de cada impresión\n",
        "init(autoreset=True)\n",
        "\n",
        "# 1. Definimos las credenciales de ambos equipos\n",
        "router_0 = {\n",
        "    'device_type': 'cisco_ios',\n",
        "    'host': '192.168.0.1',\n",
        "    'username': 'admin',\n",
        "    'password': 'admin123',\n",
        "}\n",
        "\n",
        "switch_0 = {\n",
        "    'device_type': 'cisco_ios',\n",
        "    'host': '192.168.0.2',\n",
        "    'username': 'admin',\n",
        "    'password': 'admin123',\n",
        "}\n",
        "\n",
        "# 2. Primera pregunta: ¿Desea conectarse?\n",
        "print(Fore.MAGENTA + Style.BRIGHT + \"\\n=== Asistente de Conexión de Red ===\")\n",
        "\n",
        "# Separamos el print del input para evitar los caracteres raros en Colab\n",
        "print(Fore.CYAN + \"¿Deseas conectarte por SSH? (Si/No): \")\n",
        "respuesta_ssh = input(\"> \").strip().lower()\n",
        "\n",
        "if respuesta_ssh in ['si', 's']:\n",
        "\n",
        "    # 3. Segunda pregunta: ¿A cuál equipo?\n",
        "    print(Fore.CYAN + \"¿A qué dispositivo deseas conectarte? (Router / Switch): \")\n",
        "    respuesta_equipo = input(\"> \").strip().lower()\n",
        "\n",
        "    equipo_seleccionado = None\n",
        "    nombre_equipo = \"\"\n",
        "\n",
        "    if respuesta_equipo == 'router':\n",
        "        equipo_seleccionado = router_0\n",
        "        nombre_equipo = \"Router0\"\n",
        "    elif respuesta_equipo == 'switch':\n",
        "        equipo_seleccionado = switch_0\n",
        "        nombre_equipo = \"Switch0\"\n",
        "    else:\n",
        "        print(Fore.YELLOW + \"Opción no válida. Debes escribir 'Router' o 'Switch'.\")\n",
        "        sys.exit()\n",
        "\n",
        "    # 4. Ejecución de la conexión\n",
        "    try:\n",
        "        print(Fore.BLUE + f\"\\nIniciando conexión SSH con {nombre_equipo} ({equipo_seleccionado['host']})...\")\n",
        "        conexion = ConnectHandler(**equipo_seleccionado)\n",
        "\n",
        "        print(Fore.GREEN + Style.BRIGHT + \"¡Conexión exitosa!\")\n",
        "\n",
        "        salida = conexion.send_command(\"show ip interface brief\")\n",
        "        print(Fore.MAGENTA + f\"\\n--- Resultados de {nombre_equipo} ---\")\n",
        "\n",
        "        print(salida)\n",
        "\n",
        "        conexion.disconnect()\n",
        "        print(Fore.GREEN + \"\\nConexión cerrada correctamente.\")\n",
        "\n",
        "    except Exception as e:\n",
        "        print(Fore.YELLOW + Style.BRIGHT + f\"\\nError al conectar con {nombre_equipo}. Verifica que la IP sea alcanzable o que el equipo esté encendido.\")\n",
        "        print(Fore.YELLOW + f\"Detalle técnico: {e}\")\n",
        "\n",
        "elif respuesta_ssh in ['no', 'n']:\n",
        "    print(Fore.BLUE + \"Entendido. Operación cancelada, no se realizará ninguna conexión.\")\n",
        "\n",
        "else:\n",
        "    print(Fore.YELLOW + \"Respuesta no reconocida. Por favor, ejecuta el script nuevamente y responde 'Si' o 'No'.\")"
